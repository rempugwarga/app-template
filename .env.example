# Konfigurasi OIDC — nilai di bawah adalah PUBLIK (bukan secret).
# Salin file ini ke .env.local dan isi sesuai environment Anda.
# Daftar issuer per environment: platform-docs → Identity & OIDC → Environment & URL.
# Registrasi client (self-service): platform-docs → Identity & OIDC → Registrasi Client.

PUBLIC_OIDC_ISSUER=https://id-dev.rempugwarga.example/realms/rempugwarga
PUBLIC_OIDC_CLIENT_ID=my-app
PUBLIC_OIDC_SCOPE=openid profile email roles
